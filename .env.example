# Copy to .env and fill in. Never commit real values.

# ── Database (required) ─────────────────────────────────────────────────────
# Include the database name; users and forms live in it.
MONGODB_URI="mongodb://localhost:27017/groupify"

# ── Authentication (required) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional; email/password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Public URL ──────────────────────────────────────────────────────────────
# Used in emailed links, sitemap and social previews. Defaults to the request origin
# for links, and to the production address for the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ────────────────────────────────────────────────────────
# Without a key, collaborator invites still work: you're shown the invite link to send yourself.
RESEND_API_KEY=""
EMAIL_FROM="Groupify <noreply@yourdomain.com>"

# ── Donations (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
