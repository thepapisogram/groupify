# Copy to .env and fill in. Never commit real values.

# ── Database (required) ─────────────────────────────────────────────────────
# Include the database name; users and forms live in it.
MONGODB_URI="mongodb://localhost:27017/groupify"

# ── Authentication (required) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional; email/password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Public URL ──────────────────────────────────────────────────────────────
# Used in emailed links, sitemap and social previews. Defaults to the request origin
# for links, and to the production address for the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ────────────────────────────────────────────────────────
# With a key, people who sign up with email/password must confirm their address before invitations and
# forms shared with that address work (Google sign-in counts as confirmed). Without a key, verification
# is switched off, since it couldn't be completed, and invites show a link for you to send yourself.
# Password reset also needs this key (there is no reset without email).
# Verification and reset links use NEXT_PUBLIC_APP_URL above, so set it to your real public address.
RESEND_API_KEY=""
EMAIL_FROM="Groupify <noreply@yourdomain.com>"

# ── Donations (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
